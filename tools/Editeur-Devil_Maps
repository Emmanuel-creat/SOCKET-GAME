def lancer():
    """Ouvre l'éditeur. Importé ici pour que la logique reste testable sans tkinter."""
    try:
        import tkinter as tk
        from tkinter import filedialog, messagebox, ttk
    except ImportError:
        print("tkinter est introuvable.")
        print("  Windows / macOS : il est normalement livré avec Python.")
        print("  Linux (Debian/Ubuntu) : sudo apt install python3-tk")
        return

    class Editeur:
        def __init__(self, racine):
            self.r = racine
            self.r.title("Devil Level — éditeur de cartes")
            self.r.geometry("1180x760")
            self.r.configure(bg="#1a1d26")

            self.grille = Grille(60, 14)
            self.outil = "#"
            self.peint = False
            self.efface = False
            self.modifie_ce_geste = False

            self._barre_haut()
            self._corps()
            self._barre_bas()
            self._raccourcis()
            self.redessiner()
            self.verifier(silencieux=True)

        # ---------------------------------------------------------------
        # Construction
        # ---------------------------------------------------------------

        def _barre_haut(self):
            haut = tk.Frame(self.r, bg="#22262f", pady=8, padx=10)
            haut.pack(fill="x")

            tk.Label(haut, text="Nom", bg="#22262f", fg="#cfd6e4").pack(side="left")
            self.champ_nom = tk.Entry(haut, width=22)
            self.champ_nom.insert(0, "Ma carte")
            self.champ_nom.pack(side="left", padx=(4, 14))

            tk.Label(haut, text="Thème", bg="#22262f", fg="#cfd6e4").pack(side="left")
            self.champ_theme = ttk.Combobox(haut, values=THEMES, width=12, state="readonly")
            self.champ_theme.set(THEMES[0])
            self.champ_theme.pack(side="left", padx=(4, 14))
            self.champ_theme.bind("<<ComboboxSelected>>", lambda _e: self.redessiner())

            tk.Label(haut, text="Auteur", bg="#22262f", fg="#cfd6e4").pack(side="left")
            self.champ_auteur = tk.Entry(haut, width=14)
            self.champ_auteur.pack(side="left", padx=(4, 14))

            tk.Label(haut, text="Taille", bg="#22262f", fg="#cfd6e4").pack(side="left")
            self.champ_l = tk.Spinbox(haut, from_=10, to=400, width=5, command=self.appliquer_taille)
            self.champ_l.delete(0, "end"); self.champ_l.insert(0, "60")
            self.champ_l.pack(side="left", padx=3)
            tk.Label(haut, text="×", bg="#22262f", fg="#cfd6e4").pack(side="left")
            self.champ_h = tk.Spinbox(haut, from_=5, to=60, width=4, command=self.appliquer_taille)
            self.champ_h.delete(0, "end"); self.champ_h.insert(0, "14")
            self.champ_h.pack(side="left", padx=3)

            for texte, action in (
                ("📂 Ouvrir", self.ouvrir),
                ("✓ Vérifier", self.verifier),
                ("💾 Exporter", self.exporter),
            ):
                tk.Button(haut, text=texte, command=action, bg="#3a4152", fg="#fff",
                          relief="flat", padx=10, pady=3).pack(side="right", padx=4)

        def _corps(self):
            corps = tk.Frame(self.r, bg="#1a1d26")
            corps.pack(fill="both", expand=True)

            # -- palette --
            gauche = tk.Frame(corps, bg="#22262f", width=232)
            gauche.pack(side="left", fill="y")
            gauche.pack_propagate(False)

            tk.Label(gauche, text="BLOCS", bg="#22262f", fg="#8d97ab",
                     font=("Segoe UI", 8, "bold")).pack(pady=(10, 4))

            zone = tk.Canvas(gauche, bg="#22262f", highlightthickness=0, width=214)
            barre = tk.Scrollbar(gauche, orient="vertical", command=zone.yview)
            interne = tk.Frame(zone, bg="#22262f")
            interne.bind("<Configure>", lambda _e: zone.configure(scrollregion=zone.bbox("all")))
            zone.create_window((0, 0), window=interne, anchor="nw")
            zone.configure(yscrollcommand=barre.set)
            zone.pack(side="left", fill="both", expand=True)
            barre.pack(side="right", fill="y")

            self.boutons = {}
            for famille in FAMILLES:
                tk.Label(interne, text=famille.upper(), bg="#22262f", fg="#6f7a90",
                         font=("Segoe UI", 7, "bold")).pack(anchor="w", padx=8, pady=(9, 2))
                for sym, nom, fam, fond, glyphe in BLOCS:
                    if fam != famille:
                        continue
                    b = tk.Frame(interne, bg="#22262f", cursor="hand2")
                    b.pack(fill="x", padx=6, pady=1)
                    pastille = tk.Label(b, text=sym, bg=fond, fg=glyphe, width=3,
                                        font=("Consolas", 11, "bold"))
                    pastille.pack(side="left", padx=(2, 7), pady=1)
                    etiquette = tk.Label(b, text=nom, bg="#22262f", fg="#cfd6e4",
                                         anchor="w", font=("Segoe UI", 9))
                    etiquette.pack(side="left", fill="x", expand=True)
                    for w in (b, pastille, etiquette):
                        w.bind("<Button-1>", lambda _e, s=sym: self.choisir(s))
                    self.boutons[sym] = (b, etiquette)

            # -- gomme --
            g = tk.Frame(interne, bg="#22262f", cursor="hand2")
            g.pack(fill="x", padx=6, pady=(12, 8))
            pg = tk.Label(g, text="␣", bg="#39404f", fg="#cfd6e4", width=3,
                          font=("Consolas", 11, "bold"))
            pg.pack(side="left", padx=(2, 7))
            eg = tk.Label(g, text="Gomme  (clic droit)", bg="#22262f", fg="#cfd6e4",
                          anchor="w", font=("Segoe UI", 9))
            eg.pack(side="left")
            for w in (g, pg, eg):
                w.bind("<Button-1>", lambda _e: self.choisir(VIDE))
            self.boutons[VIDE] = (g, eg)

            # -- plan de travail --
            droite = tk.Frame(corps, bg="#1a1d26")
            droite.pack(side="left", fill="both", expand=True)

            self.toile = tk.Canvas(droite, bg="#9fd4f5", highlightthickness=0)
            hbar = tk.Scrollbar(droite, orient="horizontal", command=self.toile.xview)
            vbar = tk.Scrollbar(droite, orient="vertical", command=self.toile.yview)
            self.toile.configure(xscrollcommand=hbar.set, yscrollcommand=vbar.set)
            hbar.pack(side="bottom", fill="x")
            vbar.pack(side="right", fill="y")
            self.toile.pack(side="left", fill="both", expand=True)

            self.toile.bind("<Button-1>", lambda e: self.debut_trace(e, False))
            self.toile.bind("<B1-Motion>", lambda e: self.trace(e, False))
            self.toile.bind("<ButtonRelease-1>", self.fin_trace)
            self.toile.bind("<Button-3>", lambda e: self.debut_trace(e, True))
            self.toile.bind("<B3-Motion>", lambda e: self.trace(e, True))
            self.toile.bind("<ButtonRelease-3>", self.fin_trace)
            self.toile.bind("<Motion>", self.survol)

        def _barre_bas(self):
            bas = tk.Frame(self.r, bg="#22262f", pady=6, padx=10)
            bas.pack(fill="x")
            self.etat = tk.Label(bas, text="", bg="#22262f", fg="#9fd4a0",
                                 anchor="w", font=("Segoe UI", 9))
            self.etat.pack(side="left", fill="x", expand=True)
            self.position = tk.Label(bas, text="", bg="#22262f", fg="#6f7a90",
                                     font=("Consolas", 9))
            self.position.pack(side="right")

        def _raccourcis(self):
            self.r.bind("<Control-z>", lambda _e: self.annuler())
            self.r.bind("<Control-s>", lambda _e: self.exporter())
            # Taper le symbole d'un bloc le sélectionne : c'est plus rapide que
            # de viser la palette quand on enchaîne les poses.
            self.r.bind("<Key>", self.touche)

        # ---------------------------------------------------------------
        # Interactions
        # ---------------------------------------------------------------

        def touche(self, e):
            if e.widget in (self.champ_nom, self.champ_auteur, self.champ_l, self.champ_h):
                return
            ch = e.char
            if ch and (ch in PAR_SYMBOLE or ch in ALIAS):
                self.choisir(normaliser(ch))
            elif ch == " ":
                self.choisir(VIDE)

        def choisir(self, symbole):
            self.outil = symbole
            for sym, (cadre, etiquette) in self.boutons.items():
                actif = sym == symbole
                cadre.configure(bg="#3d6ea8" if actif else "#22262f")
                etiquette.configure(bg="#3d6ea8" if actif else "#22262f",
                                    fg="#ffffff" if actif else "#cfd6e4")
            nom = "Gomme" if symbole == VIDE else PAR_SYMBOLE[symbole][1]
            self.dire(f"Outil : {nom}", "#cfd6e4")

        def case_sous(self, e):
            x = int(self.toile.canvasx(e.x) // TUILE)
            y = int(self.toile.canvasy(e.y) // TUILE)
            return x, y

        def debut_trace(self, e, gomme):
            self.grille.memoriser()
            self.modifie_ce_geste = False
            self.trace(e, gomme)

        def trace(self, e, gomme):
            x, y = self.case_sous(e)
            if not self.grille.dans(x, y):
                return
            symbole = VIDE if gomme else self.outil
            # Le départ est unique : en poser un nouveau retire l'ancien, plutôt
            # que de laisser une carte invalide avec deux « P ».
            if symbole == "P":
                ancien = trouver(self.grille, "P")
                if ancien and ancien != (x, y):
                    self.grille.poser(ancien[0], ancien[1], VIDE)
                    self.dessiner_case(*ancien)
            if self.grille.poser(x, y, symbole):
                self.dessiner_case(x, y)
                self.modifie_ce_geste = True

        def fin_trace(self, _e):
            if self.modifie_ce_geste:
                self.verifier(silencieux=True)

        def survol(self, e):
            x, y = self.case_sous(e)
            if self.grille.dans(x, y):
                ch = self.grille.lire(x, y)
                nom = PAR_SYMBOLE[ch][1] if ch in PAR_SYMBOLE else "vide"
                self.position.configure(text=f"colonne {x + 1}, ligne {y + 1} — {nom}")

        def annuler(self):
            if self.grille.annuler():
                self.redessiner()
                self.verifier(silencieux=True)
                self.dire("Annulé.", "#cfd6e4")
            else:
                self.dire("Rien à annuler.", "#cfd6e4")

        def appliquer_taille(self):
            try:
                l = int(self.champ_l.get())
                h = int(self.champ_h.get())
            except ValueError:
                return
            self.grille.memoriser()
            self.grille.redimensionner(l, h)
            self.redessiner()

        # ---------------------------------------------------------------
        # Dessin
        # ---------------------------------------------------------------

        def redessiner(self):
            self.toile.delete("all")
            fond = CIEL.get(self.champ_theme.get(), "#9fd4f5")
            self.toile.configure(bg=fond)
            L = self.grille.largeur * TUILE
            H = self.grille.hauteur * TUILE
            self.toile.configure(scrollregion=(0, 0, L, H))

            # Grille de repère : indispensable pour compter les colonnes quand
            # on aligne un piège sur une plateforme. Les traits fins sont
            # obtenus en assombrissant LÉGÈREMENT le fond — tkinter ne connaît
            # pas la transparence, il faut donc calculer la teinte.
            fin = melanger(fond, "#000000", 0.12)
            fort = melanger(fond, "#ffffff", 0.75)
            for x in range(self.grille.largeur + 1):
                couleur = fort if x % 10 == 0 else fin
                self.toile.create_line(x * TUILE, 0, x * TUILE, H, fill=couleur)
            for y in range(self.grille.hauteur + 1):
                couleur = fort if y % 5 == 0 else fin
                self.toile.create_line(0, y * TUILE, L, y * TUILE, fill=couleur)

            for y in range(self.grille.hauteur):
                for x in range(self.grille.largeur):
                    self.dessiner_case(x, y)

        def dessiner_case(self, x, y):
            self.toile.delete(f"c{x}_{y}")
            ch = self.grille.lire(x, y)
            if ch == VIDE:
                return
            bloc = PAR_SYMBOLE.get(normaliser(ch))
            if not bloc:
                return
            _, _, _, fond, glyphe = bloc
            x0, y0 = x * TUILE, y * TUILE
            demi = ch in "=ZM V^O".replace(" ", "")
            hauteur = TUILE // 2 if demi else TUILE
            decalage = TUILE // 2 if demi else 0
            self.toile.create_rectangle(
                x0 + 1, y0 + decalage + 1, x0 + TUILE - 1, y0 + decalage + hauteur - 1,
                fill=fond, outline="", tags=f"c{x}_{y}")
            self.toile.create_text(
                x0 + TUILE // 2, y0 + TUILE // 2, text=ch, fill=glyphe,
                font=("Consolas", 11, "bold"), tags=f"c{x}_{y}")

        # ---------------------------------------------------------------
        # Fichiers
        # ---------------------------------------------------------------

        def dire(self, texte, couleur="#9fd4a0"):
            self.etat.configure(text=texte, fg=couleur)

        def verifier(self, silencieux=False):
            erreurs, avertissements = valider(self.grille)
            if erreurs:
                self.dire("⚠️  " + "  ".join(erreurs), "#ff9a9a")
                return False
            resume = f"✅  {self.grille.largeur}×{self.grille.hauteur}"
            if avertissements:
                self.dire(resume + "  —  " + "  ".join(avertissements), "#ffd166")
            else:
                self.dire(resume + "  —  carte valide.", "#9fd4a0")
            return True

        def ouvrir(self):
            chemin = filedialog.askopenfilename(
                title="Ouvrir un catalogue",
                filetypes=[("Catalogue Devil Level", "*.txt"), ("Tous", "*.*")])
            if not chemin:
                return
            try:
                with open(chemin, encoding="utf-8") as f:
                    cartes = analyser_catalogue(f.read())
            except OSError as err:
                messagebox.showerror("Lecture impossible", str(err))
                return
            if not cartes:
                messagebox.showwarning("Rien à ouvrir", "Aucune carte dans ce fichier.")
                return
            self.choisir_carte(cartes)

        def choisir_carte(self, cartes):
            """Petite fenêtre de sélection quand le fichier en contient plusieurs."""
            if len(cartes) == 1:
                self.charger(cartes[0])
                return
            fen = tk.Toplevel(self.r)
            fen.title("Quelle carte ?")
            fen.configure(bg="#22262f")
            tk.Label(fen, text="Choisis une carte à ouvrir :", bg="#22262f",
                     fg="#cfd6e4", pady=8).pack()
            liste = tk.Listbox(fen, width=44, height=min(14, len(cartes)))
            for c in cartes:
                suffixe = f"  —  {c['auteur']}" if c["auteur"] else ""
                liste.insert("end", f"{c['nom']}{suffixe}")
            liste.pack(padx=12, pady=6)
            liste.selection_set(0)

            def valider_choix():
                choix = liste.curselection()
                if choix:
                    self.charger(cartes[choix[0]])
                fen.destroy()

            tk.Button(fen, text="Ouvrir", command=valider_choix, bg="#3a4152",
                      fg="#fff", relief="flat", padx=14, pady=4).pack(pady=(2, 12))

        def charger(self, carte):
            self.grille = Grille.depuis_lignes(carte["grille"])
            self.champ_nom.delete(0, "end"); self.champ_nom.insert(0, carte["nom"])
            self.champ_auteur.delete(0, "end"); self.champ_auteur.insert(0, carte["auteur"])
            if carte["theme"] in THEMES:
                self.champ_theme.set(carte["theme"])
            self.champ_l.delete(0, "end"); self.champ_l.insert(0, str(self.grille.largeur))
            self.champ_h.delete(0, "end"); self.champ_h.insert(0, str(self.grille.hauteur))
            self.redessiner()
            self.verifier(silencieux=True)
            self.dire(f"« {carte['nom']} » ouverte.", "#9fd4a0")

        def exporter(self):
            erreurs, _ = valider(self.grille)
            texte = exporter(self.champ_nom.get(), self.champ_theme.get(),
                             self.champ_auteur.get(), self.grille)

            fen = tk.Toplevel(self.r)
            fen.title("À copier dans assets/cartes.txt")
            fen.configure(bg="#22262f")
            fen.geometry("860x560")

            if erreurs:
                # On exporte quand même — le travail n'est jamais perdu — mais
                # on prévient clairement que le jeu refusera la carte en l'état.
                tk.Label(fen, text="⚠️  " + "   ".join(erreurs), bg="#5c2b2b",
                         fg="#ffd9d9", pady=6, wraplength=820).pack(fill="x")

            zone = tk.Text(fen, wrap="none", font=("Consolas", 10),
                           bg="#12151c", fg="#e8ecf4", insertbackground="#fff")
            barre_h = tk.Scrollbar(fen, orient="horizontal", command=zone.xview)
            zone.configure(xscrollcommand=barre_h.set)
            zone.insert("1.0", texte)
            barre_h.pack(side="bottom", fill="x")
            zone.pack(fill="both", expand=True, padx=10, pady=10)

            actions = tk.Frame(fen, bg="#22262f", pady=8)
            actions.pack(fill="x")

            def copier():
                self.r.clipboard_clear()
                self.r.clipboard_append(texte)
                bouton_copier.configure(text="✅ Copié !")
                fen.after(1400, lambda: bouton_copier.configure(text="📋 Copier"))

            def enregistrer():
                chemin = filedialog.asksaveasfilename(
                    title="Ajouter à un catalogue", defaultextension=".txt",
                    filetypes=[("Catalogue", "*.txt")])
                if not chemin:
                    return
                try:
                    # On AJOUTE à la fin plutôt que d'écraser : le catalogue
                    # contient les autres cartes, les perdre serait pire que
                    # tout.
                    with open(chemin, "a", encoding="utf-8") as f:
                        f.write("\n" + texte)
                    self.dire(f"Ajoutée à {chemin}", "#9fd4a0")
                    fen.destroy()
                except OSError as err:
                    messagebox.showerror("Écriture impossible", str(err))

            bouton_copier = tk.Button(actions, text="📋 Copier", command=copier,
                                      bg="#3d6ea8", fg="#fff", relief="flat",
                                      padx=16, pady=5)
            bouton_copier.pack(side="left", padx=10)
            tk.Button(actions, text="➕ Ajouter à un fichier…", command=enregistrer,
                      bg="#3a4152", fg="#fff", relief="flat", padx=16, pady=5).pack(side="left")

    racine = tk.Tk()
    Editeur(racine)
    racine.mainloop()


