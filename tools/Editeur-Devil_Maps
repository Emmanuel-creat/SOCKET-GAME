def melanger(couleur_a: str, couleur_b: str, part: float) -> str:
    """
    Mélange deux couleurs et renvoie un « #rrggbb » OPAQUE.

    ⚠️ tkinter n'accepte que 3, 6, 9 ou 12 chiffres hexadécimaux — jamais de
    canal alpha. Écrire « #00000018 » pour obtenir un noir transparent lève
    `TclError: invalid color name`. Pour obtenir un trait discret, on calcule
    donc la teinte finale ici, au lieu de compter sur une transparence qui
    n'existe pas.
    """
    a = couleur_a.lstrip("#")
    b = couleur_b.lstrip("#")
    part = max(0.0, min(1.0, part))
    canaux = []
    for i in (0, 2, 4):
        va = int(a[i:i + 2], 16)
        vb = int(b[i:i + 2], 16)
        canaux.append(round(va + (vb - va) * part))
    return "#{:02x}{:02x}{:02x}".format(*canaux)


def symbole_connu(ch: str) -> bool:
    """Le caractère correspond-il à un bloc (alias compris) ?"""
    return ch in PAR_SYMBOLE or ch in ALIAS


def normaliser(ch: str) -> str:
    """Ramène un alias à son symbole canonique."""
    return ALIAS.get(ch, ch)


def identifiant(nom: str) -> str:
    """
    Clé technique d'un nom de carte.

    Les apostrophes sont RETIRÉES et non transformées en séparateur : sinon
    « Nathan's room » et « nathans room » donneraient deux clés différentes.
    """
    sans_accent = "".join(
        c for c in unicodedata.normalize("NFD", nom)
        if unicodedata.category(c) != "Mn"
    )
    sans_apostrophe = sans_accent.replace("'", "").replace("\u2019", "")
    cle = re.sub(r"[^a-z0-9]+", "-", sans_apostrophe.lower()).strip("-")
    return cle or "carte"


class Grille:
    """Matrice de symboles, redimensionnable, avec historique d'annulation."""

    def __init__(self, largeur: int = 60, hauteur: int = 14):
        self.largeur = max(4, largeur)
        self.hauteur = max(3, hauteur)
        self.cases = [[VIDE] * self.largeur for _ in range(self.hauteur)]
        self._historique = []

    # -- lecture / écriture --

    def dans(self, x: int, y: int) -> bool:
        return 0 <= x < self.largeur and 0 <= y < self.hauteur

    def lire(self, x: int, y: int) -> str:
        return self.cases[y][x] if self.dans(x, y) else VIDE

    def poser(self, x: int, y: int, ch: str) -> bool:
        """Pose un symbole. Renvoie False si rien n'a changé."""
        if not self.dans(x, y):
            return False
        if self.cases[y][x] == ch:
            return False
        self.cases[y][x] = ch
        return True

    # -- historique --

    def memoriser(self):
        """Enregistre l'état courant avant une série de modifications."""
        self._historique.append([ligne[:] for ligne in self.cases])
        if len(self._historique) > 60:
            self._historique.pop(0)

    def annuler(self) -> bool:
        if not self._historique:
            return False
        self.cases = self._historique.pop()
        self.hauteur = len(self.cases)
        self.largeur = len(self.cases[0]) if self.cases else 0
        return True

    # -- dimensions --

    def redimensionner(self, largeur: int, hauteur: int):
        """
        Change les dimensions en conservant le contenu.

        Les lignes sont ajoutées EN HAUT et retirées EN HAUT : la première
        ligne étant le haut du niveau, agrandir doit ajouter du ciel, pas
        déplacer le sol.
        """
        largeur = max(4, largeur)
        hauteur = max(3, hauteur)
        anciennes = self.cases

        if hauteur > self.hauteur:
            ajout = [[VIDE] * self.largeur for _ in range(hauteur - self.hauteur)]
            anciennes = ajout + anciennes
        elif hauteur < self.hauteur:
            anciennes = anciennes[self.hauteur - hauteur:]

        nouvelles = []
        for ligne in anciennes:
            if largeur > len(ligne):
                nouvelles.append(ligne + [VIDE] * (largeur - len(ligne)))
            else:
                nouvelles.append(ligne[:largeur])

        self.cases = nouvelles
        self.largeur = largeur
        self.hauteur = hauteur

    # -- conversion --

    def lignes(self) -> list[str]:
        """Matrice en lignes de texte, espaces de fin retirés."""
        return ["".join(ligne).rstrip() for ligne in self.cases]

    @classmethod
    def depuis_lignes(cls, lignes: list[str]) -> "Grille":
        lignes = list(lignes) or [""]
        largeur = max(4, max(len(l) for l in lignes))
        g = cls(largeur, max(3, len(lignes)))
        for y, ligne in enumerate(lignes):
            for x, ch in enumerate(ligne):
                if x < largeur:
                    g.cases[y][x] = ch if symbole_connu(ch) else VIDE
        return g


def valider(grille: Grille) -> tuple[list[str], list[str]]:
    """
    Contrôle une carte. Renvoie (erreurs, avertissements).

    Les mêmes règles que le jeu, pour qu'une carte validée ici soit acceptée
    là-bas — vérifier dans l'éditeur n'aurait aucun intérêt sinon.
    """
    erreurs, avertissements = [], []
    compte = {}
    inconnus = set()

    for y in range(grille.hauteur):
        for x in range(grille.largeur):
            ch = grille.lire(x, y)
            if ch == VIDE or ch == ".":
                continue
            if not symbole_connu(ch):
                inconnus.add(ch)
                continue
            compte[normaliser(ch)] = compte.get(normaliser(ch), 0) + 1

    if inconnus:
        liste = ", ".join(f"« {c} »" for c in sorted(inconnus))
        erreurs.append(f"Symbole inconnu : {liste}")
    if compte.get("P", 0) == 0:
        erreurs.append("Il manque le départ « P ».")
    if compte.get("P", 0) > 1:
        erreurs.append("Il y a plusieurs départs « P » — un seul est permis.")
    if compte.get("D", 0) == 0:
        erreurs.append("Il manque la sortie « D ».")
    if compte.get("t", 0) % 2 != 0:
        erreurs.append("Les téléporteurs « t » vont par paires : il y en a un de trop.")

    if compte.get("K", 0) == 0:
        avertissements.append("Aucun checkpoint « K » : une seule erreur renverra au départ.")
    if not any(compte.get(b, 0) for b in "C12345678"):
        avertissements.append("Aucun bonus sur la carte.")
    if grille.largeur < 20:
        avertissements.append("Carte très courte (moins de 20 colonnes).")

    # Le départ posé dans le vide fait tomber le joueur dès le décompte.
    pos_p = trouver(grille, "P")
    if pos_p and not erreurs:
        x, y = pos_p
        sous = [grille.lire(x, yy) for yy in range(y + 1, grille.hauteur)]
        if not any(ch in PAR_SYMBOLE and est_porteur(ch) for ch in sous):
            avertissements.append("Rien sous le départ « P » : le joueur tombera aussitôt.")

    return erreurs, avertissements


def est_porteur(ch: str) -> bool:
    """Le bloc peut-il porter un joueur ?"""
    return ch in "#=ZrbicsowBMV"


def trouver(grille: Grille, symbole: str):
    for y in range(grille.hauteur):
        for x in range(grille.largeur):
            if grille.lire(x, y) == symbole:
                return (x, y)
    return None


def exporter(nom: str, theme: str, auteur: str, grille: Grille) -> str:
    """Produit le bloc de texte à coller dans le catalogue."""
    lignes = grille.lignes()
    # On retire les rangées vides du haut et du bas : elles n'apportent rien au
    # niveau et alourdiraient le fichier.
    while lignes and not lignes[0].strip():
        lignes.pop(0)
    while lignes and not lignes[-1].strip():
        lignes.pop()

    sortie = [f"[{nom.strip() or 'Sans titre'}]"]
    if theme:
        sortie.append(f"@theme {theme}")
    if auteur.strip():
        sortie.append(f"@auteur {auteur.strip()}")
    sortie.append("")
    sortie.extend(lignes)
    sortie.append("")
    return "\n".join(sortie)


def analyser_catalogue(texte: str) -> list[dict]:
    """
    Relit un catalogue pour en rouvrir une carte.

    Même format que le jeu : `[Nom]` démarre une carte, `@clé valeur` porte une
    métadonnée, `;` commente. On ne peut pas commenter avec « # » : c'est un
    bloc, et une rangée de murs passerait pour un titre.
    """
    cartes = []
    courante = None
    for ligne in texte.replace("\r", "").split("\n"):
        nu = ligne.lstrip()
        if nu.startswith(MARQUEUR_CARTE):
            if courante:
                cartes.append(courante)
            nom = nu.lstrip("[").rstrip()
            if nom.endswith("]"):
                nom = nom[:-1]
            courante = {"nom": nom.strip(), "theme": "prairie", "auteur": "", "grille": []}
            continue
        if courante is None or nu.startswith(MARQUEUR_COMMENTAIRE):
            continue
        if nu.startswith(MARQUEUR_META):
            morceaux = nu[1:].split(None, 1)
            cle = morceaux[0] if morceaux else ""
            valeur = morceaux[1].strip() if len(morceaux) > 1 else ""
            if cle == "theme":
                courante["theme"] = valeur or "prairie"
            elif cle == "auteur":
                courante["auteur"] = valeur
            continue
        courante["grille"].append(ligne)
    if courante:
        cartes.append(courante)

    for c in cartes:
        # Rognage aux extrémités seulement : les lignes vides du milieu sont
        # des rangées d'air et font partie du niveau.
        while c["grille"] and not c["grille"][0].strip():
            c["grille"].pop(0)
        while c["grille"] and not c["grille"][-1].strip():
            c["grille"].pop()
    return [c for c in cartes if c["nom"] and c["grille"]]


